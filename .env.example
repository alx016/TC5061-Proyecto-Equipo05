# Copy to .env (ignored by Git) and export both variables in the shell that runs `mlflow run`:
#   set -a; source .env; set +a
# config.py loads .env for the Python scripts, but the mlflow CLI only reads the shell environment.

# Tracking server started with `make mlflow-server` (port 5000 is taken by AirPlay on macOS)
MLFLOW_TRACKING_URI=http://127.0.0.1:5001
# `mlflow run` opens its run in this experiment; it must match EXPERIMENT_NAME in modeling/common.py
MLFLOW_EXPERIMENT_NAME=mibici-equipo05

# Copy to .env (ignored by Git) and export variables in the shell that runs `mlflow run`:
#   set -a; source .env; set +a
# config.py loads .env for the Python scripts, but the mlflow CLI only reads the shell environment.

# -----------------------------------------------------------------------------
# MLflow Tracking Configuration (Host CLI)
# -----------------------------------------------------------------------------
# Tracking server started with `make mlflow-server` (port 5000 is taken by AirPlay on macOS).
# Note: docker-compose.yml internally hardcodes MLFLOW_TRACKING_URI=http://mlflow:5001
# inside container networking so host-level .env files never override container bridge DNS resolution.
MLFLOW_TRACKING_URI=http://127.0.0.1:5001

# `mlflow run` opens its run in this experiment; it must match EXPERIMENT_NAME in modeling/common.py
MLFLOW_EXPERIMENT_NAME=mibici-equipo05

# -----------------------------------------------------------------------------
# Model Resolution Mode
# -----------------------------------------------------------------------------
# Default container behavior loads the immutable packaged bundle from /app/models/p2-riesgo.
# To toggle between the immutable local bundle and the live MLflow Model Registry:
#
# 1. Local immutable bundle (default for isolated container builds):
# MODEL_URI=/app/models/p2-riesgo
#
# 2. Live MLflow Model Registry (requires reachable tracking server):
# MODEL_URI=models:/mibici-equipo05-p2-riesgo@champion

# -----------------------------------------------------------------------------
# Docker Compose Host Port Mappings (Optional)
# -----------------------------------------------------------------------------
# Documented port overrides if local host port conflicts arise:
# API_PORT=8000
# MLFLOW_PORT=5001
